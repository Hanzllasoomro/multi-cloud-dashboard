# Copy to .env.local and fill in. NEVER commit .env.local or any value here.
# Names only in this file. Ledger reads these server-side only.
LEDGER_DATA_SOURCE=demo
# AWS (Cost Explorer, read-only; prefer an assumed role over static keys)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Azure (Cost Management Query REST)
AZURE_SUBSCRIPTION_ID=
AZURE_ACCESS_TOKEN=
# GCP (BigQuery billing export, REST query path)
GCP_PROJECT_ID=
GCP_BIGQUERY_DATASET=
GCP_ACCESS_TOKEN=
# Optional full BigQuery table id, e.g. my-project.my_dataset.gcp_billing_export_resource_v1
GCP_BIGQUERY_TABLE=
